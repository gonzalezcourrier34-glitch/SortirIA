# --- Mistral (tous les modèles du projet) ---
MISTRAL_API_KEY=your_mistral_key
# Facultatif : jeton Hugging Face (lecture). Le tokenizer de Mistral est
# téléchargé depuis Hugging Face ; sans jeton ça marche, avec des limites plus basses.
HF_TOKEN=
EMBEDDING_MODEL=mistral-embed
# Modèle qui lit les programmes PDF des collectivités (document_sources)
DOCUMENT_EXTRACTION_MODEL=mistral-small-latest
# Pause entre deux appels (plan gratuit de Mistral : quelques requêtes par minute)
DOCUMENT_CALL_PAUSE_S=3
# Enrichissement des événements par Mistral (catégorie, publics, résumé)
ENRICHMENT_MODEL=mistral-small-latest
ENRICHISSEMENT_ACTIF=true
# Juge de qualité : un AUTRE modèle note 20 événements tirés au hasard chaque nuit
JUDGE_MODEL=mistral-medium-latest
JUGE_ACTIF=true
# Juge de pertinence (scripts/eval_pertinence.py --juge), lancé à la main
PERTINENCE_JUDGE_MODEL=mistral-large-latest
# Le lundi, lecture des mots cherchés sans réponse (faute, synonyme, sujet, ambiance)
LEARNING_MODEL=mistral-small-latest
# Score de qualité minimal (0 à 1) : en dessous, alerte dans le mail
QUALITE_MIN=0.80

# Plafond de sécurité de la base : au-delà, les événements les plus lointains
# sont retirés (seules leurs statistiques sont gardées)
SORTIRIA_MAX_EVENEMENTS=10000

# Notes des clients : sel de l'empreinte anonyme des clients (une longue
# chaîne aléatoire, à ne jamais changer ni partager)
RATING_SALT=change_me_please_une_longue_chaine_aleatoire
MODERATION_MODEL=mistral-moderation-latest
# Rédaction des réponses de l'interface (app/search_answer.py).
SEARCH_MODEL=mistral-small-latest
# Modèle essayé si le premier échoue (panne, quota) ; vide : pas de secours.
SEARCH_FALLBACK_MODEL=mistral-medium-latest

# Surveillance de la collecte (agent/watch.py)
# Budget Mistral d'une nuit, en dollars : au-delà, alerte dans le mail
MISTRAL_BUDGET_NUIT_USD=0.50
# Minimum de sorties par semaine pour chaque case (famille/soirée x Montpellier/Thau) ; 0 = pas d'alerte
COUVERTURE_MIN_SEMAINE=10
# Sources coupées sur cette machine, séparées par des virgules (ex. « document » sur
# Azure : le site de Sète agglopôle y renvoie une page web au lieu du PDF). Vide = toutes.
SOURCES_DESACTIVEES=

# Limite de débit des routes publiques (app/rate_limit.py) ; 0 = pas de limite.
# Par visiteur : recherches par minute et par heure, avis par minute, lectures par minute ;
# pour tout le service : recherches par heure (borne le coût Mistral).
LIMITE_RECHERCHES_MINUTE=12
LIMITE_RECHERCHES_HEURE=120
LIMITE_RECHERCHES_HEURE_TOTAL=1000
LIMITE_ECRITURES_MINUTE=30
LIMITE_LECTURES_MINUTE=120

# Suivi de l'agent avec MLflow (agent/tracking.py)
# Avec le service mlflow de docker-compose (interface : http://localhost:5000) :
MLFLOW_TRACKING_URI=http://localhost:5000
# Sans serveur : laisser vide, une base locale data/mlflow/mlflow.db est utilisée
# (interface : uv run mlflow ui --backend-store-uri sqlite:///data/mlflow/mlflow.db)
MLFLOW_EXPERIMENT=sortiria-collecte
# false : collecte sans suivi
MLFLOW_ACTIF=true

# Tableau de bord Grafana (http://localhost:3001, utilisateur admin)
GRAFANA_ADMIN_PASSWORD=change_me_please
# Grafana lit aussi la base de production, en lecture seule (facultatif) :
# compte créé par `uv run python -m scripts.creer_lecteur_grafana`.
AZURE_PG_HOST=<serveur>.postgres.database.azure.com
AZURE_PG_DB=sortiria
AZURE_PG_USER=grafana_lecture
AZURE_PG_PASSWORD=change_me_please

# --- Sources d'événements ---
OPENAGENDA_API_KEY=your_openagenda_api_key
# Clé gratuite : https://www.datatourisme.fr/utiliser-les-donnees/
DATATOURISME_API_KEY=your_datatourisme_api_key
# Identité envoyée aux sites lus (robots.txt, pages d'agenda)
USER_AGENT="SortirIA/0.1 (contact: votre-email)"

# --- API ---
API_KEY=change_me

# --- PostgreSQL + pgvector ---
POSTGRES_DB=sortiria
POSTGRES_USER=sortiria
POSTGRES_PASSWORD=change_me_please
DATABASE_URL=postgresql://sortiria:change_me_please@localhost:5432/sortiria

# --- Réglages facultatifs (valeur par défaut entre parenthèses) ---
# Niveau des journaux (INFO).
# LOG_LEVEL=INFO
# Dérive : questions de la semaine en dessous desquelles un indicateur n'est pas jugé (30).
# DERIVE_MIN_QUESTIONS=30
# Évaluation de la pertinence : pause entre deux appels au juge, en secondes (3).
# JUDGE_CALL_PAUSE_S=3
# Moteur de collecte hérité de CheckIt.AI (config/settings.py) : requêtes HTTP et limites.
# REQUEST_TIMEOUT=20
# MAX_RETRIES=3
# RETRY_DELAY_SECONDS=6
# MAX_ARTICLES_PER_SOURCE=100
# MAX_ARTICLE_AGE_DAYS=7
# MIN_TITLE_LENGTH=10
# MIN_TEXT_LENGTH=0
# MIN_TOTAL_TEXT_LENGTH=30

# --- Chemins de travail du moteur de collecte (optionnels) ---
# Hérités de CheckIt.AI : par défaut data/, logs/ et secrets/ à la racine.
# CHECKIT_DATA_DIR=
# CHECKIT_LOG_DIR=
# CHECKIT_LOCAL_SECRETS_DIR=

# Bilan de la collecte nocturne par mail (agent/report.py, src/utils/mail_utils.py).
# Propositions de l'agent en pull request (16/10/2026, agent/pull_requests.py).
# Jeton GitHub « fine-grained » limité au dépôt SortirIA, droits Contents et
# Pull requests en écriture. En production : secret de la tâche
# sortiria-collecte. Vide : pas de PR, on décide avec python -m agent.proposals.
GITHUB_TOKEN_AGENT=
GITHUB_REPO=gonzalezcourrier34-glitch/SortirIA
GITHUB_BRANCHE=main

# Sans REPORT_EMAIL_TO ni SMTP_HOST, aucun mail n'est envoyé.
REPORT_EMAIL_TO=votre.adresse@exemple.fr
# toujours : un bilan chaque nuit ; alertes : seulement si problème
REPORT_EMAIL_WHEN=toujours
SMTP_HOST=smtp.gmail.com
# 587 : STARTTLS ; 465 : SSL
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
# Gmail : un mot de passe d'application, pas celui du compte
SMTP_PASSWORD=mot_de_passe_application
SMTP_FROM=
