    {
      "id": 20,
      "type": "timeseries",
      "title": "Score de qualité (juge Mistral, 20 événements par nuit)",
      "description": "Grille : cohérence, est-ce une sortie, publics, catégorie (src/event/quality_judge.py). Alerte sous QUALITE_MIN (80 %).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sortiria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sortiria-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS time, quality_score::float AS \"score\",\n       (quality ->> 'coherent')::float AS \"cohérent\", (quality ->> 'est_une_sortie')::float AS \"est une sortie\",\n       (quality ->> 'publics_corrects')::float AS \"publics\", (quality ->> 'categorie_correcte')::float AS \"catégorie\"\nFROM sortiria.collect_runs WHERE quality_score IS NOT NULL AND $__timeFilter(started_at) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
