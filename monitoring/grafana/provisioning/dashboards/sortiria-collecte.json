    {
      "id": 7,
      "type": "timeseries",
      "title": "Événements gardés par source",
      "description": "Une baisse brutale d'une source déclenche l'alerte « baisse anormale » de l'agent.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sortiria-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sortiria-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.started_at AS time, s.source_id AS metric, s.events_kept AS value\nFROM sortiria.collect_run_sources s JOIN sortiria.collect_runs r USING (run_id)\nWHERE $__timeFilter(r.started_at)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "always",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sources en échec et nouveaux essais",
      "description": "0 = lue du premier coup ; 0,5 = rattrapée au second essai (réessai ciblé) ; 1 = en échec.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sortiria-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sortiria-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.started_at AS time, s.source_id AS metric,\n       CASE WHEN s.status = 'echec' THEN 1 WHEN s.attempts > 1 THEN 0.5 ELSE 0 END AS value\nFROM sortiria.collect_run_sources s JOIN sortiria.collect_runs r USING (run_id)\nWHERE $__timeFilter(r.started_at)\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
