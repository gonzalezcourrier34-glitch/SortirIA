  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01 / Coûts Mistral (collecte de la nuit + recherche)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Coût Mistral du mois",
      "description": "Depuis le 1er du mois : collect_runs.cost_usd + rag_requests.cost_usd (tarifs de agent/watch.py, estimation).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT COALESCE(sum(cost_usd), 0) FROM sortiria.collect_runs WHERE started_at >= date_trunc('month', now()))\n+ (SELECT COALESCE(sum(cost_usd), 0) FROM sortiria.rag_requests WHERE asked_at >= date_trunc('month', now()))\n  AS \"coût du mois\""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Projection fin de mois",
      "description": "Coût du mois ramené aux jours écoulés, étendu au mois entier.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH mois AS (\n  SELECT\n    (SELECT COALESCE(sum(cost_usd), 0) FROM sortiria.collect_runs WHERE started_at >= date_trunc('month', now()))\n  + (SELECT COALESCE(sum(cost_usd), 0) FROM sortiria.rag_requests WHERE asked_at >= date_trunc('month', now())) AS cout,\n    GREATEST(EXTRACT(EPOCH FROM now() - date_trunc('month', now())) / 86400, 1) AS jours_ecoules,\n    EXTRACT(DAY FROM date_trunc('month', now()) + interval '1 month' - interval '1 day') AS jours_du_mois\n)\nSELECT cout / jours_ecoules * jours_du_mois AS \"projection fin de mois\" FROM mois"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Coût moyen d'une nuit",
      "description": "Collectes terminées sur la période (budget d'alerte de l'agent : MISTRAL_BUDGET_NUIT_USD, 0,50 $ par défaut).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(cost_usd) AS \"coût moyen d'une nuit\"\nFROM sortiria.collect_runs\nWHERE status <> 'running' AND $__timeFilter(started_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Coût moyen d'une question",
      "description": "Hors cache (une réponse en cache coûte 0 $).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(cost_usd) AS \"coût moyen d'une question\"\nFROM sortiria.rag_requests\nWHERE NOT from_cache AND cost_usd IS NOT NULL AND $__timeFilter(asked_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Coût Mistral par jour",
      "description": "Collecte de la nuit et recherche, empilées.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT jour AS time, sum(collecte) AS \"collecte (nuit)\", sum(recherche) AS \"recherche (questions)\"\nFROM (\n  SELECT date_trunc('day', started_at) AS jour, cost_usd AS collecte, 0::numeric AS recherche\n  FROM sortiria.collect_runs WHERE $__timeFilter(started_at)\n  UNION ALL\n  SELECT date_trunc('day', asked_at), 0, COALESCE(cost_usd, 0)\n  FROM sortiria.rag_requests WHERE $__timeFilter(asked_at)\n) AS couts\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 30,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      }
    },
    {
