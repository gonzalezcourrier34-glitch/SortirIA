    {
      "type": "table",
      "title": "Versions de la consigne de rédaction en service",
      "description": "PROMPT_VERSION de app/search_service.py : comparer deux versions sur la latence, le mode dégradé et la satisfaction.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(q.prompt_version, ''), 'inconnue') AS \"version de la consigne\",\n       min(q.asked_at) AS \"première question\", max(q.asked_at) AS \"dernière question\",\n       count(*) AS \"questions\",\n       avg(q.degraded::int) AS \"part sans Mistral\",\n       avg(q.latency_ms) FILTER (WHERE NOT q.from_cache) AS \"latence moyenne (ms)\",\n       avg((f.rating = 1)::int) AS \"pouces haut\",\n       count(f.feedback_id) AS \"avis\"\nFROM sortiria.rag_requests AS q\nLEFT JOIN sortiria.feedback AS f ON f.request_id = q.request_id AND f.event_id = ''\nWHERE $__timeFilter(q.asked_at)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 7
      }
    },
