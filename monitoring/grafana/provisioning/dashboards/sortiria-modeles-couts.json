    {
      "type": "table",
      "title": "Dernier rapport de dérive",
      "description": "Un indicateur par ligne, les plus inquiétants d'abord ; pour une distribution, la valeur dont la part a le plus bougé. Que faire : monitoring/README.md, section « Dérive ».",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH dernier AS (\n  SELECT drift FROM sortiria.collect_runs\n  WHERE drift <> '{}'::jsonb\n  ORDER BY started_at DESC\n  LIMIT 1\n)\nSELECT i ->> 'famille' AS \"famille\", i ->> 'nom' AS \"indicateur\", i ->> 'niveau' AS \"niveau\",\n       (i ->> 'psi')::numeric AS \"PSI\",\n       (i ->> 'reference')::numeric AS \"référence (mesure)\", (i ->> 'courant')::numeric AS \"semaine (mesure)\",\n       i -> 'ecarts' -> 0 ->> 'valeur' AS \"plus grand écart\",\n       (i -> 'ecarts' -> 0 ->> 'reference')::numeric AS \"part avant\",\n       (i -> 'ecarts' -> 0 ->> 'courant')::numeric AS \"part cette semaine\"\nFROM dernier, jsonb_array_elements(dernier.drift -> 'indicateurs') AS i\nORDER BY CASE i ->> 'niveau' WHEN 'forte' THEN 0 WHEN 'moderee' THEN 1 WHEN 'stable' THEN 2 ELSE 3 END,\n         1, 2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
