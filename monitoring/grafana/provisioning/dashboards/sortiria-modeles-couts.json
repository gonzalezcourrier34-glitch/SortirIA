          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE drift ->> 'statut'\n         WHEN 'stable' THEN 0 WHEN 'a_surveiller' THEN 1 WHEN 'derive' THEN 2 ELSE -1 END AS \"dérive\"\nFROM sortiria.collect_runs\nWHERE drift <> '{}'::jsonb\nORDER BY started_at DESC\nLIMIT 1"
