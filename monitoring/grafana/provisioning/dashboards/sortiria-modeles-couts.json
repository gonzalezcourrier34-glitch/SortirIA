    {
      "type": "timeseries",
      "title": "PSI par indicateur",
      "description": "Population Stability Index de chaque distribution (zone, public, type de sortie, moment, gratuit, type de réponse, sources, motifs de rejet). Moins de 0,10 stable, 0,10 à 0,25 modérée, au-delà forte.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
