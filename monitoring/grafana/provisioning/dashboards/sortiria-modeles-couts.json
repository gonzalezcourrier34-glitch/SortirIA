              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Modèles utilisés sur la période",
      "description": "Une ligne par modèle et par usage.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'collecte (nuit)' AS \"où\", m.key AS \"modèle\", count(DISTINCT r.run_id) AS \"nuits ou questions\",\n       sum(COALESCE((m.value ->> 'input')::bigint, 0)) AS \"tokens en entrée\",\n       sum(COALESCE((m.value ->> 'output')::bigint, 0)) AS \"tokens en sortie\"\nFROM sortiria.collect_runs AS r, jsonb_each(r.llm_usage) AS m\nWHERE $__timeFilter(r.started_at)\nGROUP BY 1, 2\nUNION ALL\nSELECT 'recherche (questions)', COALESCE(NULLIF(llm_model, ''), 'sans modèle'), count(*),\n       sum(COALESCE(prompt_tokens, 0)), sum(COALESCE(completion_tokens, 0))\nFROM sortiria.rag_requests\nWHERE NOT from_cache AND $__timeFilter(asked_at)\nGROUP BY 1, 2\nORDER BY 1, 4 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
