    {
      "type": "timeseries",
      "title": "Tokens par modèle, collecte de la nuit",
      "description": "collect_runs.llm_usage : enrichissement (small), embeddings (embed), juge (medium), PDF (small). Les tokens d'embedding sont estimés (4 caractères par token).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', r.started_at) AS time, m.key AS metric,\n       sum(COALESCE((m.value ->> 'input')::bigint, 0) + COALESCE((m.value ->> 'output')::bigint, 0)) AS value\nFROM sortiria.collect_runs AS r, jsonb_each(r.llm_usage) AS m\nWHERE $__timeFilter(r.started_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 30,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens par modèle, recherche",
      "description": "rag_requests : rédaction de la réponse, hors cache.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', asked_at) AS time, COALESCE(NULLIF(llm_model, ''), 'sans modèle') AS metric,\n       sum(COALESCE(prompt_tokens, 0) + COALESCE(completion_tokens, 0)) AS value\nFROM sortiria.rag_requests\nWHERE NOT from_cache AND $__timeFilter(asked_at)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
