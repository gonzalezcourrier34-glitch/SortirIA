          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.started_at AS time, (i ->> 'famille') || ' / ' || (i ->> 'nom') AS metric,\n       (i ->> 'psi')::numeric AS value\nFROM sortiria.collect_runs AS r, jsonb_array_elements(COALESCE(r.drift -> 'indicateurs', '[]'::jsonb)) AS i\nWHERE i ->> 'psi' IS NOT NULL AND $__timeFilter(r.started_at)\nORDER BY 1"
        }
